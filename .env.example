PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recipes_db?retryWrites=true&w=majority
# Local dev without Atlas: leave MONGO_URI empty and set:
# USE_MEMORY_DB=true
USE_MEMORY_DB=false
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
# CORS: * = כל לקוח דפדפן (מתאים לפיתוח). לאנגולר: http://localhost:4200
CLIENT_ORIGIN=*
